{
  "name": "atlas-segundo-turno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && pnpm geo && vite build --config apps/web/vite.config.ts && tsup apps/api/src/index.ts --format esm --platform node --target node22 --out-dir dist/api --external better-sqlite3",
    "baseline:round1": "tsx scripts/build-baseline.ts",
    "data:1t": "tsx scripts/fetch-round1-data.ts",
    "baseline:refresh": "tsx scripts/refresh-baseline.ts",
    "collect:official:live": "tsx scripts/collect-live.ts official 2",
    "collect:simulated:live": "tsx scripts/collect-live.ts simulated 2",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write apps packages/domain/src packages/tse/src scripts *.ts package.json",
    "format:check": "prettier --check apps packages/domain/src packages/tse/src scripts *.ts package.json",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "prototype:data": "pnpm geo && tsx scripts/build-prototype-data.ts",
    "start": "node dist/api/index.js",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "geo": "tsx scripts/build-geo.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
